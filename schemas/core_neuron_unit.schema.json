{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIMENG Core Neuron Unit Contract",
  "description": "Versioned replacement contract. Metadata does not make arbitrary tensor slicing safe.",
  "type": "object",
  "required": [
    "schema_version",
    "unit_id",
    "unit_revision",
    "unit_kind",
    "location",
    "interface",
    "parameters",
    "replacement_policy",
    "health_state"
  ],
  "properties": {
    "schema_version": {
      "const": "aimeng.core_neuron_unit.v1"
    },
    "unit_id": {
      "type": "string",
      "minLength": 1
    },
    "unit_revision": {
      "type": "integer",
      "minimum": 1
    },
    "unit_kind": {
      "enum": [
        "scalar_neuron",
        "channel",
        "neuron_group",
        "mlp_block",
        "attention_head",
        "adapter",
        "subgraph"
      ]
    },
    "location": {
      "type": "object",
      "required": [
        "model_revision",
        "component_path"
      ],
      "properties": {
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "component_path": {
          "type": "string",
          "minLength": 1
        },
        "tensor_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "index_map": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "required": [
        "inputs",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tensor"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/tensor"
          }
        },
        "dependency_unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "required": [
        "artifact_uri",
        "sha256",
        "format",
        "bytes"
      ],
      "properties": {
        "artifact_uri": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "format": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "replacement_policy": {
      "type": "object",
      "required": [
        "mode",
        "compatibility_suite",
        "rollback_revision"
      ],
      "properties": {
        "mode": {
          "enum": [
            "disabled",
            "shadow_test",
            "hot_swap_safe_point",
            "restart_required"
          ]
        },
        "compatibility_suite": {
          "type": "string",
          "minLength": 1
        },
        "rollback_revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "requires_calibration": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "health_state": {
      "enum": [
        "unverified",
        "healthy",
        "suspect",
        "quarantined",
        "replacement_candidate",
        "replaced",
        "retired"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "required": [
        "name",
        "dtype",
        "shape"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dtype": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "integer",
              "string"
            ],
            "minimum": 0
          }
        },
        "layout": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantization": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}