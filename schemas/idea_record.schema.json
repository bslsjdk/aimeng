{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bslsjdk/aimeng/schemas/idea_record.schema.json",
  "title": "AIMENG Idea Record",
  "type": "object",
  "required": ["schema_version", "idea_id", "task_id", "statement", "assumptions", "predictions", "counterexamples_to_seek", "epistemic_status", "verification_plan", "provenance"],
  "properties": {
    "schema_version": { "const": "aimeng.idea.v1" },
    "idea_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "parent_idea_id": { "type": ["string", "null"] },
    "statement": { "type": "string", "minLength": 1 },
    "novelty_axis": { "type": "string", "minLength": 1 },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "mechanism": { "type": "string" },
    "predictions": { "type": "array", "items": { "type": "string" } },
    "counterexamples_to_seek": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "risk_and_cost": { "type": "object", "properties": { "risk": { "type": "string" }, "estimated_cost": { "type": ["string", "number", "null"] }, "reversible": { "type": ["boolean", "null"] } }, "additionalProperties": true },
    "epistemic_status": { "enum": ["speculative", "plausible", "supported", "verified_for_scope", "refuted", "unknown"] },
    "verification_plan": { "type": "object", "required": ["method"], "properties": { "method": { "type": "string", "minLength": 1 }, "acceptance_criteria": { "type": "array", "items": { "type": "string" } }, "scope": { "type": "object" } }, "additionalProperties": true },
    "verification_result": { "type": ["object", "null"], "properties": { "status": { "enum": ["pass", "fail", "inconclusive", "unavailable"] }, "verifier_id": { "type": "string" }, "verifier_version": { "type": "string" }, "scope": { "type": "object" }, "evidence_refs": { "type": "array", "items": { "type": "string" } }, "metrics": { "type": "object" }, "limitations": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true },
    "result_refs": { "type": "array", "items": { "type": "string" } },
    "provenance": { "type": "object", "required": ["model_version", "policy_version"], "properties": { "model_version": { "type": "string", "minLength": 1 }, "policy_version": { "type": "string", "minLength": 1 }, "source_ref": { "type": ["string", "null"] } }, "additionalProperties": true },
    "created_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "epistemic_status": { "const": "verified_for_scope" } }, "required": ["epistemic_status"] },
      "then": {
        "required": ["verification_result"],
        "properties": {
          "verification_result": {
            "type": "object",
            "required": ["status", "verifier_id", "verifier_version", "scope", "evidence_refs"],
            "properties": { "status": { "const": "pass" }, "verifier_id": { "type": "string", "minLength": 1 }, "verifier_version": { "type": "string", "minLength": 1 }, "evidence_refs": { "type": "array", "minItems": 1 } }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
